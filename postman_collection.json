{
  "info": {
    "name": "Resource Booking System REST API",
    "description": "Comprehensive Postman collection for testing Authentication, RBAC, Resources, and Reservations.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "userToken",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Admin Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.token) {",
                  "    pm.collectionVariables.set('adminToken', jsonData.token);",
                  "    pm.environment.set('adminToken', jsonData.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "User Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.token) {",
                  "    pm.collectionVariables.set('userToken', jsonData.token);",
                  "    pm.environment.set('userToken', jsonData.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"user1\",\n  \"password\": \"user123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"newuser\",\n  \"email\": \"newuser@example.com\",\n  \"password\": \"newuser123\",\n  \"role\": \"ROLE_USER\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Resources",
      "item": [
        {
          "name": "Get All Resources (User or Admin)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/resources?availableOnly=true",
              "host": ["{{baseUrl}}"],
              "path": ["api", "resources"],
              "query": [
                {
                  "key": "availableOnly",
                  "value": "true"
                }
              ]
            }
          }
        },
        {
          "name": "Get Resource by ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/resources/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "resources", "1"]
            }
          }
        },
        {
          "name": "Create Resource [ADMIN ONLY]",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Virtual Reality Lab\",\n  \"description\": \"Immersive VR simulation suite with Meta Quest 3 and HTC Vive Pro headsets\",\n  \"type\": \"ROOM\",\n  \"pricePerHour\": 65.00,\n  \"available\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/resources",
              "host": ["{{baseUrl}}"],
              "path": ["api", "resources"]
            }
          }
        },
        {
          "name": "Update Resource [ADMIN ONLY]",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Executive Conference Room A (Upgraded)\",\n  \"description\": \"Updated with dual 8K screens\",\n  \"type\": \"ROOM\",\n  \"pricePerHour\": 55.00,\n  \"available\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/resources/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "resources", "1"]
            }
          }
        },
        {
          "name": "Delete Resource [ADMIN ONLY]",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/resources/3",
              "host": ["{{baseUrl}}"],
              "path": ["api", "resources", "3"]
            }
          }
        }
      ]
    },
    {
      "name": "3. Reservations",
      "item": [
        {
          "name": "Create Reservation [USER] (Identity from JWT)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"resourceId\": 1,\n  \"startTime\": \"2026-10-05T09:00:00\",\n  \"endTime\": \"2026-10-05T12:00:00\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/reservations",
              "host": ["{{baseUrl}}"],
              "path": ["api", "reservations"]
            }
          }
        },
        {
          "name": "List Reservations with Filters & Pagination (USER or ADMIN)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/reservations?status=CONFIRMED&minPrice=50&maxPrice=1500&page=0&size=10&sortBy=price&sortDir=desc",
              "host": ["{{baseUrl}}"],
              "path": ["api", "reservations"],
              "query": [
                {
                  "key": "status",
                  "value": "CONFIRMED"
                },
                {
                  "key": "minPrice",
                  "value": "50"
                },
                {
                  "key": "maxPrice",
                  "value": "1500"
                },
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "10"
                },
                {
                  "key": "sortBy",
                  "value": "price"
                },
                {
                  "key": "sortDir",
                  "value": "desc"
                }
              ]
            }
          }
        },
        {
          "name": "Get Reservation by ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/reservations/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "reservations", "1"]
            }
          }
        },
        {
          "name": "Update or Cancel Reservation",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"CANCELLED\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/reservations/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "reservations", "1"]
            }
          }
        },
        {
          "name": "Delete Reservation [ADMIN or Owner]",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/reservations/3",
              "host": ["{{baseUrl}}"],
              "path": ["api", "reservations", "3"]
            }
          }
        }
      ]
    }
  ]
}
